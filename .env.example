# â”€â”€ Portfolio runtime config (all optional, safe defaults in lib/config.ts) â”€â”€

# GitHub username used by the live sync layer
GITHUB_USERNAME=karkalashivareddy

# Optional GitHub token (raises API rate limit 60/hr â†’ 5,000/hr). NEVER commit a real token.
# GITHUB_TOKEN=

# GitHub snapshot freshness window (default 15 min)
GITHUB_TTL_MS=900000

# Codolio public profile key
CODOLIO_USER_KEY=2520030105

# Codolio snapshot freshness window (default 60 min)
CODOLIO_TTL_MS=3600000

# Admin dashboard gate. Empty = admin pages disabled.
# Generate one, e.g. `openssl rand -hex 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
ADMIN_TOKEN=

# Force the admin cookie off Secure (default: Secure=true in production).
# Only for local dev over plain http or behind a TLS-terminating proxy.
# ADMIN_COOKIE_SECURE=false

# GitHub webhook secret (for /api/webhooks/github). Must match the secret set on GitHub.
GITHUB_WEBHOOK_SECRET=

# Analytics toggle (default enabled)
ANALYTICS_ENABLED=true

# README generation mode: "true" = auto; leave unset for manual-only.
AUTO_UPDATE_README=false

# Require explicit approval before saved README is used (default true)
README_APPROVAL_REQUIRED=true

# Canonical site URL used for OG/metadata/canonical links
NEXT_PUBLIC_SITE_URL=https://portfolio.shivareddy.dev